# Куда сервер Next.js ходит за контентом. Публичный контент читается public-ролью,
# токен не нужен (study-strapi/scripts/setup-permissions.js).
# На VPS можно поставить http://127.0.0.1:1341 — в обход nginx.
STRAPI_URL=https://admin.studycz.cz

# Публичный адрес Strapi — база для картинок из локального upload-провайдера.
# Медиа после миграции лежат в ImageKit и приходят абсолютными URL, так что обычно не нужен.
NEXT_PUBLIC_STRAPI_URL=https://admin.studycz.cz

# Канонический адрес сайта — метатеги, sitemap, robots
NEXT_PUBLIC_SITE_URL=https://studycz.cz

# Секрет вебхука Strapi → POST /api/revalidate (сброс ISR-кеша при публикации)
REVALIDATE_SECRET=
